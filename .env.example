# Environment Variables Configuration
NODE_ENV=development
PORT=3000

# Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="منصة تعليم الوضوء والصلاة"

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/wudu_salah_db
MONGODB_DB_NAME=wudu_salah_db

# Security & Authentication
ADMIN_JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_in_production
SESSION_MAX_AGE_DAYS=7

# External API Integrations (Optional / Fallback to local verified database)
SUNNAH_API_KEY=
DORAR_API_KEY=
